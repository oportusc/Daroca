---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import matrimonio from "../assets/imagenes/servicio_matrimonio.webp";
import coffeeBreak from "../assets/imagenes/servicio_coffee_break.webp";
import principal from "../assets/imagenes/servicios_principal.webp";

// Eventos Empresa y Graduaciones usan fotos de stock (Unsplash): reemplazar por fotos propias cuando estén disponibles
const services = [
  {
    title: "Matrimonios",
    forWho: "Para el día más importante, íntimo o con cientos de invitados.",
    description: "Hacemos realidad el día más especial de tu vida. Nos encargamos de cada detalle del banquete: menús personalizados, decoración elegante y un servicio impecable.",
    image: matrimonio,
    features: ["Menú personalizado", "Decoración incluida", "Servicio de meseros", "Coordinación del evento"],
  },
  {
    title: "Coffee Break",
    forWho: "Para reuniones, seminarios y talleres que necesitan una buena pausa.",
    description: "Variedad de cafés gourmet, tés, pastelería fresca, frutas y snacks saludables. Ideal para mantener a tus asistentes energizados y concentrados.",
    image: coffeeBreak,
    features: ["Café gourmet", "Pastelería fresca", "Opciones saludables", "Servicio rápido"],
  },
  {
    title: "Eventos Empresa",
    forWho: "Para lanzamientos, conferencias, reuniones y cenas de gala.",
    description: "Servicios profesionales para eventos corporativos. Menús ejecutivos, coffee breaks y cenas de gala que impresionarán a tus invitados, con la logística resuelta.",
    image: "https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&q=80&w=1080",
    features: ["Menús ejecutivos", "Coffee breaks", "Servicio premium", "Logística completa"],
  },
  {
    title: "Graduaciones",
    forWho: "Para ceremonias formales o fiestas más relajadas.",
    description: "Celebra tu logro académico con estilo. Buffets variados, cócteles y postres especiales para hacer de este momento algo inolvidable.",
    image: "https://images.unsplash.com/photo-1758682016275-59c2dd2e0aee?auto=format&fit=crop&q=80&w=1080",
    imagePosition: "center 25%",
    features: ["Buffet variado", "Opciones vegetarianas", "Torta de graduación", "Bebidas incluidas"],
  },
];
---

<BaseLayout
  title="Servicios de Banquetería | Daroca Eventos"
  description="Banquetería para matrimonios, graduaciones, eventos de empresa y coffee breaks en Villa Alemana, Viña del Mar, Valparaíso y la Quinta Región."
>
  {/* Hero */}
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Banquetería para cada celebración</h1>
        <p class="hero-text">
          Matrimonios, coffee breaks, eventos de empresa y graduaciones en Villa Alemana,
          Viña del Mar, Valparaíso y toda la Quinta Región.
        </p>
        <a href="/contactanos" class="btn">Cotizar mi evento</a>
      </div>
      <figure class="hero-img">
        <Image
          src={principal}
          alt="Panel de fotos junto a la piscina en un evento atendido por Daroca"
          widths={[500, 900]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  {/* Servicios: una fila por servicio, con fondos alternados */}
  {services.map((service) => (
    <article class="row">
      <div class="wrap row-grid">
        <div>
          <h2>{service.title}</h2>
          <p class="for-who">{service.forWho}</p>
        </div>

        <div>
          <p class="row-text">{service.description}</p>
          <ul class="features">
            {service.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <a href="/contactanos" class="btn btn-ghost">
            Cotizar {service.title.toLowerCase()}
          </a>
        </div>

        <figure class="row-img">
          <Image
            src={service.image}
            alt={service.title}
            inferSize
            widths={[500, 900]}
            sizes="(min-width: 1024px) 30vw, 100vw"
            style={service.imagePosition && `object-position: ${service.imagePosition}`}
          />
        </figure>
      </div>
    </article>
  ))}

  {/* Cierre */}
  <section class="close">
    <div class="wrap close-grid">
      <div>
        <h2>¿Tu evento es distinto?</h2>
        <p>
          Cumpleaños, bautizos, aniversarios o algo que no aparece aquí.
          Cuéntanos y armamos una propuesta a tu medida.
        </p>
      </div>
      <a href="/contactanos" class="btn">Contarnos mi idea</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  h1,
  h2 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--primary);
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
    transition: background-color 0.2s, color 0.2s, transform 0.15s;
  }
  .btn:hover {
    background: #1f6b6b;
  }
  .btn:active {
    transform: scale(0.97);
  }
  .btn-ghost {
    background: transparent;
    color: var(--foreground);
    box-shadow: inset 0 0 0 2px var(--foreground);
  }
  .btn-ghost:hover {
    background: var(--foreground);
    color: #fff;
  }

  /* Hero */
  .hero {
    padding-block: 4rem 5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 4.6vw, 4rem);
  }
  .hero-text {
    font-size: 1.125rem;
    margin: 1.5rem 0 2rem;
    max-width: 40ch;
  }
  .hero-img {
    aspect-ratio: 4 / 5;
    max-height: 560px;
    width: 100%;
    border-radius: 240px 240px 0 0;
    overflow: hidden;
  }
  .hero-img img,
  .row-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Filas de servicios */
  .row {
    padding-block: 4.5rem;
  }
  .row:nth-of-type(odd) {
    background: #fff;
  }
  .row:nth-of-type(even) {
    background: var(--secondary);
  }
  .row-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 0.9fr;
    gap: 2.5rem;
    align-items: start;
  }
  .row h2 {
    font-size: clamp(2.25rem, 3.6vw, 3.25rem);
  }
  .for-who {
    font-size: 1.0625rem;
    margin-top: 1rem;
    max-width: 28ch;
    color: #4a4a46;
  }
  .row-text {
    font-size: 1.0625rem;
  }
  .features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem 1.25rem;
    margin: 1.5rem 0 1.75rem;
  }
  .features li {
    position: relative;
    padding-left: 1.25rem;
  }
  .features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
  }
  .row-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
  }
  .row-img img {
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .row:hover .row-img img {
    transform: scale(1.04);
  }

  /* Cierre */
  /* Fondo claro: así no choca con el footer teal */
  .close {
    padding-block: 4.5rem;
  }
  .close-grid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .close h2 {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
  }
  .close p {
    font-size: 1.0625rem;
    margin-top: 0.75rem;
    max-width: 48ch;
  }

  @media (max-width: 1023px) {
    .hero-grid,
    .row-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      padding-block: 3rem;
    }
    .hero-img {
      aspect-ratio: 1 / 1;
      max-height: 460px;
    }
    .row {
      padding-block: 3rem;
    }
    .row-img {
      aspect-ratio: 16 / 10;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .features {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .row-img img {
      transition: none;
    }
  }
</style>
