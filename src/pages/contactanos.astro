---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ContactForm } from "../components/ContactForm";
import { site } from "../config/site";

const hours = [
  { days: "Lunes a viernes", time: "9:00 – 19:00" },
  { days: "Sábados", time: "10:00 – 14:00" },
  { days: "Domingos", time: "Cerrado" },
];
---

<BaseLayout
  title="Contáctanos y Cotiza tu Evento | Daroca Eventos"
  description="Cotiza la banquetería de tu matrimonio, graduación, coffee break o evento corporativo en la Quinta Región. Escríbenos y te respondemos en menos de 24 horas."
>
  {/*
    Formulario oculto para que Netlify Forms detecte el formulario de contacto al compilar.
    Los campos deben coincidir con los de src/components/ContactForm.tsx
  */}
  <form name="contacto" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input type="text" name="name" />
    <input type="email" name="email" />
    <input type="tel" name="phone" />
    <input type="text" name="eventType" />
    <input type="date" name="eventDate" />
    <input type="number" name="guestCount" />
    <textarea name="message"></textarea>
    <input type="text" name="bot-field" />
  </form>

  <section class="contact">
    <div class="wrap">
      <header class="head">
        <h1>Hablemos de tu evento</h1>
        <p class="lead">Cotización gratis y sin compromiso. Respondemos en menos de 24 horas.</p>
      </header>

      <div class="grid">
        {/* Datos de contacto */}
        <aside class="info">
          <h2>Datos de contacto</h2>
          <div class="ways">
            <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
              <small>WhatsApp o llamada</small>
              <span>{site.phone}</span>
            </a>
            <a href={`mailto:${site.email}`}>
              <small>Correo</small>
              <span>{site.email}</span>
            </a>
            <div>
              <small>Dónde estamos</small>
              <span>{site.location}</span>
            </div>
          </div>

          <div class="hours">
            <h3>Horario de atención</h3>
            {hours.map((h) => (
              <p><span>{h.days}</span><span>{h.time}</span></p>
            ))}
          </div>
        </aside>

        {/* Formulario */}
        <div class="form-card">
          <h2>Pide tu cotización</h2>
          <p class="note">Los campos con * son obligatorios.</p>
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: 4rem;
  }
  .wrap {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: #1f6b6b;
  }

  .head {
    margin-bottom: 2.5rem;
  }
  .head h1 {
    font-size: clamp(2.5rem, 4.2vw, 3.75rem);
  }
  .lead {
    font-size: 1.125rem;
    margin-top: 1rem;
    max-width: 62ch;
  }

  .grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2rem;
    align-items: start;
  }

  /* Cuadro de datos: arena, con el horario en blanco */
  .info {
    background: var(--primary);
    color: #fff;
    border-radius: 24px;
    padding: 2.25rem 2rem;
  }
  .info h2,
  .info h3 {
    color: #fff;
  }
  .info h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }
  .ways {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2rem;
  }
  .ways small {
    display: block;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  /* Lora en vez de Cormorant: sus números van alineados y se leen mejor */
  .ways span {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    font-variant-numeric: lining-nums;
    overflow-wrap: anywhere;
  }
  .ways a:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hours {
    background: #1f6b6b;
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
  }
  .hours h3 {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
  }
  .hours p {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* Cuadro del formulario */
  .form-card {
    background: #fff;
    border-radius: 24px;
    padding: 2.25rem 2.5rem 2.5rem;
  }
  .form-card h2 {
    font-size: clamp(1.9rem, 2.6vw, 2.4rem);
    margin-bottom: 0.5rem;
  }
  .note {
    font-size: 0.95rem;
    color: #4a4a46;
    margin-bottom: 2rem;
  }

  @media (max-width: 1023px) {
    .contact {
      padding-top: 3rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .form-card {
      order: -1;
    }
  }
  @media (max-width: 560px) {
    .info,
    .form-card {
      padding: 1.75rem 1.25rem;
    }
  }
</style>
