---
import { Image } from "astro:assets";
import { Calendar, Users, Award, Heart, MessageCircle } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";

import mesas from "../assets/imagenes/mesas_puesta_sol.webp";
import coffee from "../assets/imagenes/coffee_galletas_2.webp";
import mesaCerca from "../assets/imagenes/mesa_cerca.webp";
import mesasGaleria from "../assets/imagenes/mesas_3.webp";
import coffeeGalletas from "../assets/imagenes/coffee_galletas_2.webp";
import mesaGaleria from "../assets/imagenes/mesa_2.webp";

const features = [
  {
    icon: Calendar,
    title: "Planificación completa",
    description: "Organizamos matrimonios, graduaciones y eventos corporativos en la Quinta Región, cuidando cada detalle."
  },
  {
    icon: Users,
    title: "Equipo profesional",
    description: "Contamos con personal con experiencia en atención y montaje para todo tipo de eventos."
  },
  {
    icon: Award,
    title: "Calidad en cada preparación",
    description: "Trabajamos con ingredientes frescos y cuidamos la presentación para una experiencia de alto nivel."
  },
  {
    icon: Heart,
    title: "Atención personalizada",
    description: "Adaptamos cada servicio a tus necesidades, ya sea un matrimonio, graduación o coffee break empresarial."
  }
];

const galleryPreview = [
  { src: mesasGaleria, alt: "Mesas decoradas para un evento al aire libre" },
  { src: coffeeGalletas, alt: "Coffee break con galletas y café" },
  { src: mesaGaleria, alt: "Mesa decorada para banquete" },
];

// Cada imagen del hero ocupa un tercio del ancho en escritorio y todo el ancho en celular
const heroWidths = [480, 800, 1200];
---

<BaseLayout title="Banquetería en Viña del Mar y Quinta Región | Daroca Eventos">
  {/* Hero Section */}
  <section class="relative w-full h-[85vh] grid grid-cols-1 md:grid-cols-3 overflow-hidden">
    {/* Imágenes */}
    <Image
      src={mesaCerca}
      alt="Banquetería para eventos en la Quinta Región"
      widths={heroWidths}
      sizes="33vw"
      class="w-full h-full object-cover hidden md:block"
    />
    <Image
      src={coffee}
      alt="Decoración de matrimonios en Viña del Mar"
      widths={heroWidths}
      sizes="33vw"
      class="w-full h-full object-cover hidden md:block"
    />
    <Image
      src={mesas}
      alt="Coffee break para empresas en Valparaíso"
      widths={heroWidths}
      sizes="(min-width: 768px) 33vw, 100vw"
      priority
      class="w-full h-full object-cover"
    />

    {/* Overlay oscuro */}
    <div class="absolute inset-0 bg-black/45"></div>

    {/* Contenido */}
    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-6">
      <h1
        class="text-5xl sm:text-6xl md:text-7xl mb-6"
        style="font-family: var(--font-heading); font-weight: 700"
      >
        Banquetería en Villa Alemana y Quinta Región
      </h1>
      <p class="text-3xl sm:text-4xl mb-2 font-semibold" style="font-family: var(--font-body)">
        Daroca Eventos
      </p>

      <p class="text-lg sm:text-xl mb-6 max-w-2xl" style="font-family: var(--font-body)">
        Matrimonios, graduaciones, coffee breaks y eventos corporativos
      </p>

      <a
        href="/contactanos"
        class="inline-block px-8 py-4 rounded-lg transition-all transform hover:scale-105"
        style="background-color: var(--secondary); color: var(--secondary-foreground); font-family: var(--font-body); font-weight: 600"
      >
        Solicita tu Cotización
      </a>
    </div>
  </section>

  {/* Features Section */}
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <h2
        class="text-4xl md:text-5xl text-center mb-16"
        style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
      >
        ¿Por qué elegir Daroca Eventos?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((feature) => {
          const Icon = feature.icon;
          return (
            <div
              class="text-center p-6 rounded-lg transition-all hover:shadow-lg"
              style="background-color: white"
            >
              <div
                class="inline-flex items-center justify-center w-16 h-16 rounded-full mb-4"
                style="background-color: var(--secondary)"
              >
                <Icon className="w-8 h-8" style={{ color: "var(--primary)" }} />
              </div>
              <h3
                class="text-xl mb-3"
                style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
              >
                {feature.title}
              </h3>
              <p style="color: var(--foreground)">{feature.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* Gallery Preview Section */}
  <section class="py-20 px-4" style="background-color: white">
    <div class="max-w-7xl mx-auto">
      <h2
        class="text-4xl md:text-5xl text-center mb-16"
        style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
      >
        Algunos de nuestros eventos
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {galleryPreview.map((image) => (
          <div class="relative h-80 overflow-hidden rounded-lg shadow-lg">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[400, 800]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="w-full h-full object-cover transition-transform hover:scale-110 duration-300"
            />
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="/galeria"
          class="inline-block px-8 py-4 rounded-lg transition-all transform hover:scale-105"
          style="background-color: var(--primary); color: var(--primary-foreground); font-family: var(--font-body); font-weight: 600"
        >
          Ver galería completa
        </a>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="py-20 px-4" style="background-color: var(--secondary)">
    <div class="max-w-4xl mx-auto text-center">
      <h2
        class="text-4xl md:text-5xl mb-6"
        style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
      >
        Cotiza tu evento en minutos
      </h2>
      <p class="text-lg md:text-xl mb-8" style="color: var(--foreground)">
        Escríbenos por WhatsApp y recibe una propuesta personalizada para tu matrimonio, graduación o evento corporativo.
      </p>
      <a
        href={site.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-lg transition-all transform hover:scale-105"
        style="background-color: var(--primary); color: var(--primary-foreground); font-family: var(--font-body); font-weight: 600"
      >
        <MessageCircle className="w-6 h-6" />
        Cotizar por WhatsApp
      </a>

      <p class="text-gray-500 text-sm pt-2">* Cupos limitados por fecha</p>
    </div>
  </section>
</BaseLayout>
