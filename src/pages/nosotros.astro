---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import nosotrosImg from "../assets/imagenes/nosotros.webp";

const values = [
  {
    title: "Excelencia",
    description:
      "Nos comprometemos a ofrecer siempre el más alto estándar en cada servicio, desde la selección de ingredientes hasta la presentación final.",
  },
  {
    title: "Compromiso",
    description:
      "Tu evento es nuestra prioridad. Nos dedicamos completamente a asegurar que cada detalle sea perfecto y supere tus expectativas.",
  },
  {
    title: "Innovación",
    description:
      "Nos mantenemos actualizados con las últimas tendencias en banquetería y eventos para ofrecer propuestas creativas y modernas.",
  },
];
---

<BaseLayout
  title="Nosotros | Daroca Eventos"
  description="Conoce a Daroca Eventos: banquetería en Villa Alemana y la Quinta Región, con atención personalizada, calidad y compromiso en cada matrimonio, graduación y evento corporativo."
>
  <div class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      {/* Header */}
      <div class="text-center mb-16">
        <h1
          class="text-5xl md:text-6xl mb-6"
          style="font-family: var(--font-heading); color: var(--primary); font-weight: 700"
        >
          Nosotros
        </h1>
        <div class="w-24 h-1 mx-auto" style="background-color: var(--secondary)"></div>
      </div>

      {/* Main Content */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
        <div>
          <h2
            class="text-3xl md:text-4xl mb-6"
            style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
          >
            Nuestra Historia
          </h2>
          <div class="space-y-4 text-lg" style="color: var(--foreground)">
            <p>
              Daroca Eventos nace de la pasión por crear experiencias memorables y la dedicación
              al servicio de excelencia. Con más de una década de experiencia en el rubro de la
              banquetería, hemos tenido el honor de ser parte de miles de celebraciones que han
              marcado la vida de nuestros clientes.
            </p>
            <p>
              Nuestra filosofía se basa en la atención al detalle, la calidad superior de nuestros
              productos y el servicio personalizado que caracteriza cada evento que organizamos.
              Entendemos que cada celebración es única y merece un tratamiento especial.
            </p>
            <p>
              A lo largo de los años, hemos perfeccionado nuestros procesos, expandido nuestro
              equipo de profesionales y construido relaciones duraderas con proveedores de primera
              calidad, todo con el objetivo de ofrecer a nuestros clientes una experiencia
              incomparable.
            </p>
          </div>
        </div>

        <div class="relative h-80 lg:h-auto overflow-hidden rounded-lg shadow-lg">
          <Image
            src={nosotrosImg}
            alt="Integrante del equipo de Daroca Eventos con delantal bordado, en un montaje de ceremonia al aire libre"
            widths={[600, 1000]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="w-full h-full object-cover object-[50%_30%] lg:absolute lg:inset-0"
          />
        </div>
      </div>

      {/* Values Section */}
      <div class="py-16 px-8 rounded-lg mb-16" style="background-color: white">
        <h2
          class="text-3xl md:text-4xl text-center mb-12"
          style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
        >
          Nuestros Valores
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {values.map((value, index) => (
            <div class="text-center">
              <div
                class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center"
                style="background-color: var(--secondary)"
              >
                <span
                  class="text-3xl"
                  style="font-family: var(--font-heading); color: var(--primary); font-weight: 700"
                >
                  {index + 1}
                </span>
              </div>
              <h3
                class="text-2xl mb-3"
                style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
              >
                {value.title}
              </h3>
              <p style="color: var(--foreground)">{value.description}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Mission & Vision */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-lg" style="background-color: var(--secondary)">
          <h2
            class="text-3xl mb-4"
            style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
          >
            Nuestra Misión
          </h2>
          <p class="text-lg" style="color: var(--foreground)">
            Brindar servicios de banquetería y organización de eventos de la más alta calidad,
            creando experiencias memorables que superen las expectativas de nuestros clientes
            y sean recordadas por años.
          </p>
        </div>

        <div class="p-8 rounded-lg" style="background-color: white">
          <h2
            class="text-3xl mb-4"
            style="font-family: var(--font-heading); color: var(--primary); font-weight: 600"
          >
            Nuestra Visión
          </h2>
          <p class="text-lg" style="color: var(--foreground)">
            Ser reconocidos como la empresa líder en banquetería y organización de eventos,
            destacándonos por nuestra innovación, calidad y el trato personalizado que
            caracteriza cada uno de nuestros servicios.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
