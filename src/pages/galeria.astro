---
import { Image, getImage } from "astro:assets";
import { X, ChevronLeft, ChevronRight } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import { galleryImages } from "../data/gallery";

// Versión grande para el visor (se descarga solo al abrir la foto)
const images = await Promise.all(
  galleryImages.map(async (image) => ({
    ...image,
    full: await getImage({ src: image.src, width: 1200 }),
  }))
);
---

<BaseLayout
  title="Galería de Eventos | Daroca Eventos"
  description="Fotos de nuestros eventos: montajes de mesas, coffee breaks y barras para matrimonios, graduaciones y eventos corporativos en la Quinta Región."
>
  <div class="py-16 px-4">
    <div class="max-w-7xl mx-auto">
      {/* Header */}
      <div class="text-center mb-16">
        <h1
          class="text-5xl md:text-6xl mb-6"
          style="font-family: var(--font-heading); color: var(--primary); font-weight: 700"
        >
          Galería
        </h1>
        <p class="text-xl max-w-3xl mx-auto" style="color: var(--foreground)">
          Algunos de los eventos que hemos tenido el gusto de preparar
        </p>
        <div class="w-24 h-1 mx-auto mt-6" style="background-color: var(--secondary)"></div>
      </div>

      {/* Grid */}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {images.map((image, index) => (
          <button
            type="button"
            class="gallery-item relative aspect-[3/4] overflow-hidden rounded-lg shadow-lg cursor-zoom-in"
            data-index={index}
            data-full={image.full.src}
            data-alt={image.alt}
            aria-label={`Ver foto: ${image.alt}`}
          >
            <Image
              src={image.src}
              alt={image.alt}
              widths={[300, 450, 600]}
              sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
              class="w-full h-full object-cover transition-transform hover:scale-105 duration-300"
            />
          </button>
        ))}
      </div>
    </div>
  </div>

  {/* Visor de fotos */}
  <dialog
    id="lightbox"
    class="m-auto max-w-none max-h-none w-full h-full bg-transparent p-0 backdrop:bg-black/90"
    aria-label="Visor de fotos"
  >
    <div class="relative w-full h-full flex items-center justify-center p-4 sm:p-12">
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-full object-contain rounded-lg" />

      <button
        type="button"
        data-action="close"
        class="absolute top-4 right-4 p-2 rounded-full bg-black/50 text-white"
        aria-label="Cerrar"
      >
        <X className="w-7 h-7" />
      </button>
      <button
        type="button"
        data-action="prev"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 text-white"
        aria-label="Foto anterior"
      >
        <ChevronLeft className="w-8 h-8" />
      </button>
      <button
        type="button"
        data-action="next"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 p-2 rounded-full bg-black/50 text-white"
        aria-label="Foto siguiente"
      >
        <ChevronRight className="w-8 h-8" />
      </button>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
    const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-item"));
    let current = 0;

    const show = (index: number) => {
      if (!lightboxImage || items.length === 0) return;
      current = (index + items.length) % items.length;
      const item = items[current];
      lightboxImage.src = item.dataset.full ?? "";
      lightboxImage.alt = item.dataset.alt ?? "";
    };

    items.forEach((item, index) => {
      item.addEventListener("click", () => {
        show(index);
        dialog?.showModal();
      });
    });

    dialog?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>("[data-action]")?.dataset.action;

      if (action === "prev") show(current - 1);
      else if (action === "next") show(current + 1);
      // Cierra con el botón X o al hacer clic fuera de la foto
      else if (action === "close" || target !== lightboxImage) dialog.close();
    });

    dialog?.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });
  </script>
</BaseLayout>
